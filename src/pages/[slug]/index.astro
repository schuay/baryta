---
import Base from '../../layouts/Base.astro';
import Sequence from '../../components/Sequence.astro';
import Grid from '../../components/Grid.astro';
import { getSite } from '../../lib/site.ts';
import type { Gallery, Page } from '../../lib/model.ts';

export async function getStaticPaths() {
  const site = await getSite();
  return [
    ...site.galleries.map((gallery) => ({ params: { slug: gallery.slug }, props: { gallery } })),
    ...site.pages.map((page) => ({ params: { slug: page.slug }, props: { page } })),
  ];
}

const { gallery, page } = Astro.props as { gallery?: Gallery; page?: Page };
const site = await getSite();
---

{
  gallery && (
    <Base site={site} title={gallery.title} theme={gallery.theme} fill={gallery.view === 'sequence'}>
      {gallery.view === 'sequence' ? <Sequence gallery={gallery} siteTitle={site.title} /> : <Grid gallery={gallery} siteTitle={site.title} />}
    </Base>
  )
}
{
  page && (
    <Base site={site} title={page.title} current={page.slug}>
      <article class="page prose">
        <h1>{page.title}</h1>
        <Fragment set:html={page.html} />
      </article>
    </Base>
  )
}
