---
import Base from '../../layouts/Base.astro';
import Sequence from '../../components/Sequence.astro';
import Grid from '../../components/Grid.astro';
import { getSite } from '../../lib/site.ts';
import { otherView } from '../../lib/routes.ts';
import type { Gallery, View } from '../../lib/model.ts';

// Each gallery's secondary view; the primary one is served at /slug/.
export async function getStaticPaths() {
  const site = await getSite();
  return site.galleries.map((gallery) => {
    const view = otherView(gallery.view);
    return { params: { slug: gallery.slug, view }, props: { gallery, view } };
  });
}

const { gallery, view } = Astro.props as { gallery: Gallery; view: View };
const site = await getSite();
---

<Base site={site} title={gallery.title} theme={gallery.theme} fill={view === 'sequence'}>
  {view === 'sequence' ? <Sequence gallery={gallery} siteTitle={site.title} /> : <Grid gallery={gallery} siteTitle={site.title} />}
</Base>
