---
import type { Gallery } from '../lib/model.ts';
import Plate from './Plate.astro';
import SequenceBar from './SequenceBar.astro';
import { viewHref } from '../lib/routes.ts';

interface Props {
  gallery: Gallery;
  siteTitle: string;
}
const { gallery: g, siteTitle } = Astro.props;
// The page number always occupies the first caption line.
const capLines = Math.max(1, g.captionLines);
const firstPlate = g.frames.findIndex((f) => f.kind === 'plate');
---

<section
  class="sequence"
  aria-roledescription="carousel"
  aria-label={g.title}
  style={`--cap-lines: ${capLines}`}
  data-index-href={viewHref(g, 'grid')}
>
  <div class="track" tabindex="0">
    {
      g.frames.map((f, i) => (
        <div
          class="frame"
          role="group"
          aria-roledescription="slide"
          aria-label={f.kind === 'plate' ? `${f.number} of ${g.plateCount}` : 'Introduction'}
          data-number={f.kind === 'plate' ? f.number : undefined}
          data-split={f.kind === 'plate' && f.splittable ? '' : undefined}
        >
          <div class="stage">
            {f.kind === 'plate' && (
              <Plate
                frame={f}
                mode="stage"
                count={g.plateCount}
                eager={Math.abs(i - firstPlate) <= 1}
                priority={i === firstPlate}
              />
            )}
            {f.kind === 'text' && <div class="text-frame prose" set:html={f.html} />}
          </div>
        </div>
      ))
    }
  </div>
  <script is:inline>
    // Jump to #n before first paint; the module script takes over afterwards.
    {
      const track = document.currentScript.previousElementSibling;
      const n = parseInt(location.hash.slice(1), 10);
      const target = [...track.querySelectorAll(`[data-number="${n}"]`)].find((el) => {
        const cs = getComputedStyle(el);
        return cs.display !== 'contents' && cs.display !== 'none' && cs.scrollSnapAlign !== 'none';
      });
      if (target) track.scrollLeft = target.offsetLeft;
    }
  </script>
  <button class="step prev" type="button" aria-label="Previous">
    <svg viewBox="0 0 16 40" aria-hidden="true"><polyline points="14,2 2,20 14,38"></polyline></svg>
  </button>
  <button class="step next" type="button" aria-label="Next">
    <svg viewBox="0 0 16 40" aria-hidden="true"><polyline points="2,2 14,20 2,38"></polyline></svg>
  </button>
</section>
<SequenceBar gallery={g} siteTitle={siteTitle} />

<script>
  import { initSequence } from '../scripts/sequence.ts';
  const el = document.querySelector<HTMLElement>('.sequence');
  if (el) initSequence(el);
</script>
