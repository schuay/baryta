---
import type { Img } from '../lib/model.ts';

interface Props {
  img: Img;
  alt: string;
  sizes: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}
const { img, alt, sizes, loading = 'lazy', fetchpriority, class: cls } = Astro.props;
const avif = img.variants.map((v) => `${v.avif} ${v.width}w`).join(', ');
const jpeg = img.variants.map((v) => `${v.jpeg} ${v.width}w`).join(', ');
const fallback = img.variants.find((v) => v.width >= 1200) ?? img.variants.at(-1)!;
---

<picture>
  <source type="image/avif" srcset={avif} sizes={sizes} />
  <img
    class={cls}
    src={fallback.jpeg}
    srcset={jpeg}
    sizes={sizes}
    width={img.width}
    height={img.height}
    alt={alt}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
  />
</picture>
