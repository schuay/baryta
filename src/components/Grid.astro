---
import type { Gallery } from '../lib/model.ts';
import Plate from './Plate.astro';
import GalleryBar from './GalleryBar.astro';
import { viewHref } from '../lib/routes.ts';

interface Props {
  gallery: Gallery;
}
const { gallery: g } = Astro.props;
const seq = viewHref(g, 'sequence');
const plates = g.frames.filter((f) => f.kind === 'plate');
// Cells take the shape of the widest frame, between square and 2:1, so
// spreads and groups are not shrunk into squares.
const cell = Math.min(2, Math.max(1, ...plates.map((f) => f.aspect)));
---

<GalleryBar gallery={g} view="grid" />
{g.introHtml && <div class="intro prose" set:html={g.introHtml} />}
<ol class="grid" style={`--cell: ${cell.toFixed(4)}`}>
  {
    plates.map((f, i) => (
      <li>
        <a href={`${seq}#${f.number}`} aria-label={`${f.number} of ${plates.length}`}>
          <Plate frame={f} mode="thumb" eager={i < 12} />
        </a>
      </li>
    ))
  }
</ol>
